+export const ORDER_COLUMNS = [
+  { key: "orderNo", label: "订单号" },
+  { key: "customer", label: "客户名称" },
+  { key: "amount", label: "订单金额" },
+  { key: "status", label: "订单状态" },
+  { key: "createdAt", label: "下单时间" },
+  { key: "paidAt", label: "支付时间" },
+  { key: "channel", label: "渠道" },
+  { key: "remark", label: "备注" },
+] as const;
+
+export type OrderColumnKey = (typeof ORDER_COLUMNS)[number]["key"];
+
+export const DEFAULT_COLUMNS: OrderColumnKey[] = ["orderNo", "customer", "amount", "status", "createdAt"];
+
+export function pickColumns<T extends Record<string, unknown>>(row: T, keys: OrderColumnKey[]) {
+  return keys.map((k) => {
+    const col = ORDER_COLUMNS.find((c) => c.key === k)!;
+    return [col.label, row[k]] as const;
+  });
+}
