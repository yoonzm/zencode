+func TestHandleCallbackTimeout(t *testing.T) {
+	h := newTestHandler(t)
+	h.queryTimeout = 50 * time.Millisecond
+	// 测试内注入会响应 ctx 取消的 fake，不改动 internal/testutil
+	h.bank = &slowBank{delay: 2 * time.Second}
+
+	if err := h.HandleCallback(context.Background(), CallbackRequest{OrderNo: "A100", TradeNo: "T1"}); err != nil {
+		t.Fatalf("HandleCallback() error = %v", err)
+	}
+	got, _ := h.orders.Get(context.Background(), "A100")
+	if got.Status != StatusPendingConfirm {
+		t.Errorf("超时后订单应保持待确认，got %s", got.Status)
+	}
+}
+
+type slowBank struct{ delay time.Duration }
+
+func (b *slowBank) Query(ctx context.Context, _ string) (string, error) {
+	select {
+	case <-time.After(b.delay):
+		return "PAID", nil
+	case <-ctx.Done():
+		return "", ctx.Err()
+	}
+}
